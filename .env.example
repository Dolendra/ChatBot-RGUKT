# Get a key at https://console.groq.com/keys
# One line, no spaces around = :
#   GROQ_API_KEY=gsk_your_actual_key_here
# If the key is rejected: no leading/trailing spaces, save the file, restart uvicorn.
# Optional: show name in the UI (defaults from RAG_PDF_PATH filename)
# APP_TITLE=Academic regulations handbook
# APP_SUBTITLE=Ask about admissions, attendance, and exams.

GROQ_API_KEY=

# Optional: GROQ_MODEL=llama-3.3-70b-versatile
# Optional RAG tuning: RAG_CONTEXT_CHARS_PER_CHUNK=1100  RAG_HISTORY_MAX_MESSAGES=14