# Get a key at https://console.groq.com/keys
# One line, no spaces around = :
#   GROQ_API_KEY=gsk_your_actual_key_here
# If the key is rejected: no leading/trailing spaces, save the file, restart uvicorn.
#
# Optional UI branding:
# APP_TITLE=RGUKT Academic Assistant
# APP_SUBTITLE=Ask about admissions, attendance, and exams.
#
# Optional CORS (comma-separated). Defaults include local Vite + production Vercel UI.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://chatbot-rgukt.vercel.app
#
# Optional model / RAG tuning:
# GROQ_MODEL must be a model id available on YOUR Groq account (404/empty = config issue).
# Smoke-tested example: GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_MAX_TOKENS=900
# RAG_VERIFY=1
# RAG_SIMILARITY_THRESHOLD=-5.0
# RAG_CONTEXT_CHARS_PER_CHUNK=1100
# RAG_HISTORY_MAX_MESSAGES=14

GROQ_API_KEY=
